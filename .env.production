# Production builds are served from finance.evyoog.com, a different origin than
# the API, so requests must go to an absolute URL (there is no Vite proxy in a
# built bundle). finance.evyoog.com must stay in the backend CORS allowlist —
# see evyoog-gl SecurityConfig.corsConfigurationSource().
VITE_API_BASE_URL=https://finance-api.evyoog.com
